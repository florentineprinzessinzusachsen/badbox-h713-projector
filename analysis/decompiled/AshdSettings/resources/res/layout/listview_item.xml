<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/listview_selector"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/list_status_img"
        android:paddingLeft="@dimen/setting_list_pad"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/setting_list_size"
        android:id="@+id/list_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@+id/list_status_img"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/setting_list_size"
        android:layout_gravity="center_vertical"
        android:id="@+id/list_status_text"
        android:paddingRight="20dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/list_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/setting_list_size"
        android:id="@+id/summary"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginLeft="60dp"
        android:text="@string/app_name"
        android:layout_below="@+id/list_content"/>
</RelativeLayout>
