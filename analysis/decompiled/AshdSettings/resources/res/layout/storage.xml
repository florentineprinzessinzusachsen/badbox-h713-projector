<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="@dimen/setting_content_padlr"
    android:paddingTop="@dimen/setting_content_padtb"
    android:paddingRight="@dimen/setting_content_padlr"
    android:paddingBottom="@dimen/setting_content_padtb"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/title"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/setting_title_size"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/app_text"
            android:paddingLeft="@dimen/viewpager_left"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/viewpager_icon_h"
            android:text="@string/app_name"
            android:drawableLeft="@drawable/settings_icon"/>
        <ImageView
            android:id="@+id/title_img"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/arrow_right"/>
        <TextView
            android:textSize="@dimen/setting_title_size"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/storeinfo"/>
    </LinearLayout>
    <TextView
        android:background="@drawable/settings_head_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/viewpager_icon_textsize"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/storage0"/>
            <TextView
                android:textSize="40dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/sdcard"
                android:paddingLeft="@dimen/setting_list_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/SDstore"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="150dp"
            android:layout_marginRight="150dp">
            <TextView
                android:textSize="30dp"
                android:textColor="#ffffffff"
                android:id="@+id/sdcard_total_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/SDallspace"
                android:layout_weight="1"/>
            <TextView
                android:textSize="30dp"
                android:textColor="#ffffffff"
                android:gravity="right"
                android:id="@+id/sdcard_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="150dp"
            android:layout_marginRight="150dp">
            <TextView
                android:textSize="30dp"
                android:textColor="#ffffffff"
                android:id="@+id/sdcard_available_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/SDablespace"
                android:layout_weight="1"/>
            <TextView
                android:textSize="30dp"
                android:textColor="#ffffffff"
                android:gravity="right"
                android:id="@+id/sdcard_available"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageView_line0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/setting_listview_split"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/viewpager_icon_textsize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/storage2"/>
            <TextView
                android:textSize="40dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/nandflash"
                android:paddingLeft="@dimen/setting_list_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/NandFlash"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="150dp"
            android:layout_marginRight="150dp">
            <TextView
                android:textSize="30dp"
                android:textColor="#ffffffff"
                android:id="@+id/nand_total_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/Nandallspace"
                android:layout_weight="1"/>
            <TextView
                android:textSize="30dp"
                android:textColor="#ffffffff"
                android:gravity="right"
                android:id="@+id/nand_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Nandallspace"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="150dp"
            android:layout_marginRight="150dp">
            <TextView
                android:textSize="30dp"
                android:textColor="#ffffffff"
                android:id="@+id/nand_available_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/Nandablespace"
                android:layout_weight="1"/>
            <TextView
                android:textSize="30dp"
                android:textColor="#ffffffff"
                android:gravity="right"
                android:id="@+id/nand_available"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
