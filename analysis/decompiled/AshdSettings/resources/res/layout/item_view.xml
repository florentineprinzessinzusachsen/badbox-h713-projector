<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1">
    <TextView
        android:textSize="@dimen/viewpager_item_textsize"
        android:ellipsize="marquee"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/view_item0"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="@dimen/viewpager_item_h"
        android:layout_height="@dimen/viewpager_item_w"
        android:layout_marginLeft="@dimen/viewpager_item_padding_lr1"
        android:layout_marginTop="@dimen/viewpager_item_padding_tp"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="@dimen/viewpager_item_textsize"
        android:ellipsize="marquee"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/view_item1"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="@dimen/viewpager_item_h"
        android:layout_height="@dimen/viewpager_item_w"
        android:layout_marginTop="@dimen/viewpager_item_padding_tp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/view_item0"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="@dimen/viewpager_item_textsize"
        android:ellipsize="marquee"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/view_item2"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="@dimen/viewpager_item_h"
        android:layout_height="@dimen/viewpager_item_w"
        android:layout_marginTop="@dimen/viewpager_item_padding_tp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/view_item1"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="@dimen/viewpager_item_textsize"
        android:ellipsize="marquee"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/view_item3"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="@dimen/viewpager_item_h"
        android:layout_height="@dimen/viewpager_item_w"
        android:layout_marginTop="@dimen/viewpager_item_padding_tp"
        android:singleLine="true"
        android:layout_toRightOf="@+id/view_item2"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="@dimen/viewpager_item_textsize"
        android:ellipsize="marquee"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/view_item4"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="@dimen/viewpager_item_h"
        android:layout_height="@dimen/viewpager_item_w"
        android:layout_marginLeft="@dimen/viewpager_item_padding_lr1"
        android:singleLine="true"
        android:layout_below="@+id/view_item0"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="@dimen/viewpager_item_textsize"
        android:ellipsize="marquee"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/view_item5"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="@dimen/viewpager_item_h"
        android:layout_height="@dimen/viewpager_item_w"
        android:singleLine="true"
        android:layout_toRightOf="@+id/view_item4"
        android:layout_below="@+id/view_item1"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="@dimen/viewpager_item_textsize"
        android:ellipsize="marquee"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/view_item6"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="@dimen/viewpager_item_h"
        android:layout_height="@dimen/viewpager_item_w"
        android:singleLine="true"
        android:layout_toRightOf="@+id/view_item5"
        android:layout_below="@+id/view_item2"
        android:marqueeRepeatLimit="marquee_forever"/>
    <TextView
        android:textSize="@dimen/viewpager_item_textsize"
        android:ellipsize="marquee"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/view_item7"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="@dimen/viewpager_item_h"
        android:layout_height="@dimen/viewpager_item_w"
        android:singleLine="true"
        android:layout_toRightOf="@+id/view_item6"
        android:layout_below="@+id/view_item3"
        android:marqueeRepeatLimit="marquee_forever"/>
</RelativeLayout>
